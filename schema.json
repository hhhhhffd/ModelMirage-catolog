{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hhhhhffd/ModelMirage-catolog/main/schema.json",
  "title": "ModelMirage item catalog v1",
  "type": "object",
  "required": [
    "schema",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "models": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "format",
          "model",
          "textures"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "format": {
            "const": "java-item"
          },
          "model": {
            "$ref": "#/$defs/asset"
          },
          "textures": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/asset"
            },
            "minProperties": 1
          },
          "parents": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/asset"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    }
  }
}
